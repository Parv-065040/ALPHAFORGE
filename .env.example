# Copy to .env and fill in YOUR OWN values. Never commit .env.
# Alpaca PAPER trading keys (https://alpaca.markets -> Paper Trading -> API Keys)
ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_here
# Must stay true. ALPHAFORGE has no live-trading path and refuses to start otherwise.
ALPACA_PAPER=true

# Master switch for order submission. Default false: nothing is ever submitted.
ENABLE_PAPER_TRADING=false
# Short selling stays off until course rules AND your account permit it.
ALLOW_SHORTING=false

# Local models
USE_FINBERT=true
FINBERT_MODEL=ProsusAI/finbert
USE_LLM=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:4b

# Optional overrides
ALPHAFORGE_CONFIG=config/default.yaml
ALPHAFORGE_DB_PATH=data/alphaforge.db
ALPHAFORGE_LOG_LEVEL=INFO
